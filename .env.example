# 容器内的服务名（postgres / redis）在 compose 网络里可正确解析，因此保留原名。
# 若要在**宿主机**直连容器，请用 127.0.0.1 + 发布端口（5433 / 6389），
# 不要用 localhost：Windows 上 localhost 优先解析到 IPv6 ::1，而 Docker 只发布 IPv4，
# 会导致连接挂到超时（见 DECISIONS 019）。
APP_ENV=development

# 控制 SQLAlchemy echo（每条 SQL 一条日志）与 FastAPI debug；生产必须 false。
# 注：docker-compose.prod.yml 已显式注入 DEBUG=false，无需在 .env 里重复设置。
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/taskflow

# PostgreSQL 容器凭据。compose 用它们拼容器内 DATABASE_URL（服务名 postgres）。
# 生产 compose 要求 POSTGRES_PASSWORD 必须设置（$VAR:? 必填语法，缺失即拒绝启动）。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskflow

REDIS_URL=redis://redis:6379/0

# 生产 compose 要求必须设置，且不得沿用这里的开发默认值（$VAR:? 必填语法）。
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me

ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_DAYS=7

UPLOAD_DIR=storage

MAX_UPLOAD_SIZE=10485760

# 滑动窗口限流（§22）。规格未定义数值，此处为可覆盖的默认值（见 DECISIONS 015）。
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ENABLED=true

# Celery（§23 / TASK-048）。BROKER / BACKEND 留空时回落到 REDIS_URL（DECISIONS 026）。
#CELERY_BROKER_URL=
#CELERY_RESULT_BACKEND=
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
CELERY_RESULT_EXPIRES=3600

# 日志（§33 / TASK-056，见 DECISIONS 037）。
# LOG_FORMAT=auto：按 APP_ENV 推导（production→json，其余→text）；亦可显式 json / text。
LOG_LEVEL=INFO
LOG_FORMAT=auto
# 请求访问日志（method/path/status_code/duration）开关；生产建议 true。
LOG_REQUESTS=true

# ---------------------------------------------------------------------------
# 反向代理（§31 / TASK-060）
# ---------------------------------------------------------------------------
# 生产链路是 Client → Nginx → Gunicorn → Uvicorn Worker → FastAPI。
# Nginx 用 $remote_addr **覆盖**写入 X-Forwarded-For；应用只在下面两条同时成立
# 时才采信它（判定逻辑见 app/core/client_ip.py，理由见 DECISIONS 018 / 040）：
#   1) TRUST_PROXY_HEADERS=true；
#   2) 请求的 TCP 对端落在 TRUSTED_PROXY_IPS 网段内。
# 缺任何一条都回落到对端地址（fail-safe）——代价是「按 IP 限流」退化成所有
# 匿名用户共享一份配额，但**不会**变成「攻击者随便伪造就换一份新配额」。
# 本地跑应用（无 Nginx）时保持注释状态即可；docker-compose.prod.yml 已显式注入
# 生产所需的两条值，与它声明的固定子网一致（tests/test_nginx_config.py 交叉校验）。
#TRUST_PROXY_HEADERS=true
#TRUSTED_PROXY_IPS=172.28.0.0/24

# Nginx 对外端口（仅 docker-compose.prod.yml 使用）。默认 80；本机验证常用高位端口。
#NGINX_HTTP_PORT=80

# Gunicorn worker 进程数（§31；规格未定义数值，取 2 并可调，见 DECISIONS 041）。
# 经验值约为 CPU 核数，但需按内存与下游连接数（Postgres 池大小）调整。
#WEB_CONCURRENCY=2

