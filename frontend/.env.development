# 开发环境（前端规格 §54 / §55）
#
# 关于 VITE_API_BASE_URL 为什么是相对路径：
#   规格 §54 的示例写的是 `http://localhost:8000/api/v1`，但本项目后端
#   `app/main.py` **没有注册 CORSMiddleware**（全仓 grep 不到），浏览器直连
#   8000 会被同源策略拦掉。改成相对路径后请求打到 Vite Dev Server，
#   由 §55 的代理转发到 8000——对浏览器而言是同源的。
#
#   生产环境两者一致（都走 Nginx 的 /api 反代），所以这个偏差只影响开发环境。
VITE_APP_TITLE=团队任务协作系统
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
